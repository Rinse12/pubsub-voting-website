# systemd unit for the pubsub-voting seeder (deployed on new-plebbit).
# Precompile once, then install (adjust paths/user; systemd has no nvm PATH, so
# ExecStart must use the absolute node binary — `command -v node` shows it):
#   npx tsc -p tsconfig.seeder.json
#   sudo cp seeder/pubsub-voting-seeder.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pubsub-voting-seeder
#   journalctl -fu pubsub-voting-seeder
[Unit]
Description=pubsub-voting seeder (libp2p AutoTLS node for browser voters)
After=network-online.target
Wants=network-online.target

[Service]
# CHANGE ME: the user that owns the checkout
User=root
# CHANGE ME: where the repo is cloned
WorkingDirectory=/root/pubsub-voting-website
# CHANGE ME: absolute node path (nvm installs are not on systemd's PATH)
ExecStart=/root/.nvm/versions/node/v22.22.2/bin/node /root/pubsub-voting-website/dist-seeder/seeder/seeder.js
Environment=SEEDER_DATA=/root/pubsub-voting-website/seeder-data
# Set when the machine is behind provider NAT (interfaces only have private IPs),
# so AutoTLS doesn't have to wait for AutoNAT to confirm the public address:
Environment=PUBLIC_IP=89.36.231.48
Restart=on-failure
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
