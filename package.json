    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/router-fault-tolerance.test.ts && tsx tests/eligibility-view.test.ts",
    "topic": "tsx scripts/derive-topic.ts",
    "manifest": "tsx scripts/generate-directory-manifest.ts"
  },
  "dependencies": {
    "@bitsocial/bso-resolver": "0.0.10",
    "@bitsocial/pubsub-voting": "0.7.1",
