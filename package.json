    "@chainsafe/libp2p-yamux": "8.0.1",
    "@helia/bitswap": "4.0.14",
    "@helia/delegated-routing-v1-http-api-client": "9.0.2",
    "@helia/libp2p": "2.1.3",
    "@ipld/dag-cbor": "10.0.2",
    "@ipshipyard/libp2p-auto-tls": "2.0.2",
    "@libp2p/autonat": "3.0.27",
    "@libp2p/bootstrap": "12.0.30",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/fetch": "4.1.12",
