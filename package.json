{
  "name": "pubsub-voting-website",
  "private": true,
  "version": "0.0.1",
  "description": "Browser voting over libp2p pubsub, gated by an ERC-20 (BSO) balance — web client + AutoTLS seeder node.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "topic": "tsx scripts/derive-topic.ts",
    "seeder": "tsc -p tsconfig.seeder.json && node dist-seeder/seeder/seeder.js"
  },
  "dependencies": {
    "@bitsocial/bso-resolver": "0.0.10",
    "@bitsocial/pubsub-voting": "0.0.10",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@ipshipyard/libp2p-auto-tls": "2.0.2",
    "@libp2p/autonat": "3.0.23",
    "@libp2p/bootstrap": "12.0.26",
    "@libp2p/crypto": "5.1.21",
    "@libp2p/fetch": "4.1.7",
    "@libp2p/gossipsub": "16.0.3",
    "@libp2p/http": "2.0.6",
    "@libp2p/identify": "4.1.8",
    "@libp2p/keychain": "6.1.4",
    "@libp2p/tcp": "11.0.22",
    "@libp2p/websockets": "10.1.16",
    "@multiformats/multiaddr": "13.0.3",
    "datastore-fs": "12.0.1",
    "helia": "6.1.4",
    "libp2p": "3.3.5",
    "viem": "2.54.0",
    "zod": "4.3.6"
  },
  "overrides": {
    "@libp2p/interface": "3.2.5"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  }
}
