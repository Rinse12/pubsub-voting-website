    "@libp2p/identify": "4.1.13",
    "@libp2p/keychain": "6.1.7",
    "@libp2p/tcp": "11.0.27",
    "@libp2p/websockets": "10.1.20",
    "@multiformats/multiaddr": "13.0.3",
    "@pkcprotocol/pkc-js": "0.0.92",
    "datastore-fs": "12.0.1",
    "helia": "7.1.10",
    "libp2p": "3.3.9",
    "multiformats": "14.0.5",
    "viem": "2.56.0",
    "zod": "4.3.6"
